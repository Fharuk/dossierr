# Copy to .env next to compose.yml, fill in, then `docker compose up -d`.

# --- Caddy ------------------------------------------------------------------
# The address Dossier is reached at, which must already point at this server.
# A DuckDNS name is free: https://www.duckdns.org
DOSSIER_HOST=dossier.example.com

# When "03:00" is, for nightly backups, and what the dashboard calls today.
TZ=Africa/Lagos

# --- Required ---------------------------------------------------------------
# A hash of the password you sign in with, never the password itself:
#   docker run --rm -it ghcr.io/aientech/dossier hash-password
DOSSIER_PASSWORD=

# Signs sessions and encrypts stored API keys. 32+ random characters:
#   openssl rand -base64 32
DOSSIER_SECRET=

# PostgreSQL. Neon's free plan (0.5 GB, no card, no inactivity pause):
# console.neon.tech → your project → Connect → the connection string, plus
# ?sslmode=require. Neon's pooled address (the one ending in -pooler) works too.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/dossier?sslmode=require

# --- AI: Google Gemini, free tier -------------------------------------------
# A key from https://aistudio.google.com/apikey (no card). The free tier gives
# roughly 10 requests a minute and 1,500 a day, and Google may use what you
# send to improve its products — read Privacy in the wiki before putting your
# CV through it. Dossier reaches it through its OpenAI-compatible endpoint.
# All of these can be changed later in Settings → AI provider, which wins.
DOSSIER_AI_PROVIDER=openai
DOSSIER_AI_URL=https://generativelanguage.googleapis.com/v1beta/openai
DOSSIER_AI_MODEL=gemini-3.8-flash
DOSSIER_AI_KEY=

# --- Optional ---------------------------------------------------------------
# The usage ping: off, so Dossier never asks or sends.
DOSSIER_TELEMETRY=off

# Job sources. freehire needs no key (company career pages); jsearch and
# adzuna want their own free-tier keys.
DOSSIER_JOBS_SOURCE=freehire
# DOSSIER_JSEARCH_KEY=
# DOSSIER_ADZUNA_APP_ID=
# DOSSIER_ADZUNA_KEY=

# Gmail and Calendar (Settings → Google can take these instead).
# DOSSIER_GOOGLE_CLIENT_ID=
# DOSSIER_GOOGLE_CLIENT_SECRET=
